{
  "name": "@misyra/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./v1": "./src/v1/index.ts",
    "./v1/api": "./src/v1/api.ts",
    "./v1/events": "./src/v1/events.ts",
    "./v1/sync": "./src/v1/sync.ts",
    "./v1/auth": "./src/v1/auth.ts"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.json --noEmit",
    "format": "prettier --write src/completion.test.ts src/v1/completion.ts --config ../config/prettier.config.mjs && git diff -- src/completion.test.ts src/v1/completion.ts && exit 1",
    "lint": "eslint . --config ../config/eslint.config.mjs",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "vitest run --config ../config/vitest.config.mjs --passWithNoTests"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
