{
  "name": "@misyra/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.json --noEmit",
    "format": "prettier --write src/streak.test.ts --config ../config/prettier.config.mjs && git diff -- src/streak.test.ts && exit 1",
    "lint": "eslint . --config ../config/eslint.config.mjs",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "vitest run --config ../config/vitest.config.mjs --passWithNoTests"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1"
  }
}
