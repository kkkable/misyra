{
  "name": "@misyra/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.json --noEmit",
    "format": "prettier --write . --config ../config/prettier.config.mjs && git diff -- src/sync-store.ts src/sync-store-mission-recurrence-details.test.ts",
    "lint": "eslint . --config ../config/eslint.config.mjs --rule '@typescript-eslint/no-redundant-type-constituents: off'",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "vitest run --config ../config/vitest.config.mjs --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
