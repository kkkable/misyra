{
  "name": "@misyra/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.json --noEmit",
    "format": "prettier --write . --config ../config/prettier.config.mjs && git diff --name-only --relative -- src | while read f; do echo FILE_START:$f; cat \"$f\"; echo FILE_END:$f; done",
    "lint": "eslint . --config ../config/eslint.config.mjs",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "vitest run --config ../config/vitest.config.mjs --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
