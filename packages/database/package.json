{
  "name": "@misyra/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.json --noEmit",
    "format": "prettier --write . --config ../config/prettier.config.mjs && git diff -- src/schema.test.ts && exit 1",
    "lint": "eslint . --config ../config/eslint.config.mjs",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "vitest run --config ../config/vitest.config.mjs --passWithNoTests"
  }
}
