# Local development defaults only. Copy to .env when overrides are needed.
POSTGRES_DB=misyra
POSTGRES_USER=misyra
POSTGRES_PASSWORD=misyra-local-only
POSTGRES_PORT=5432
# When changing POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_PORT, update DATABASE_URL to match.
DATABASE_URL=postgresql://misyra:misyra-local-only@127.0.0.1:5432/misyra

AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
# When changing AZURITE_BLOB_PORT/AZURITE_QUEUE_PORT/AZURITE_TABLE_PORT, update AZURE_STORAGE_CONNECTION_STRING to matching explicit emulator endpoints.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Local-safe authentication placeholders. Replace with approved provider configuration outside local development.
APPLE_AUTH_AUDIENCE=fixture-apple-auth-audience
GOOGLE_AUTH_AUDIENCE=fixture-google-auth-audience
AUTH_ACCESS_TOKEN_SECRET=fixture-local-auth-access-token-secret

# Local-safe Google Calendar OAuth placeholders. Production values remain an external configuration gate.
GOOGLE_CALENDAR_CLIENT_ID=fixture-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=fixture-google-calendar-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3000/v1/calendars/google/callback
GOOGLE_CALENDAR_WEBHOOK_ADDRESS=http://127.0.0.1:3000/v1/webhooks/google-calendar
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc
