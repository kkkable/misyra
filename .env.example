# Local development defaults only. Copy to .env when overrides are needed.
POSTGRES_DB=misyra
POSTGRES_USER=misyra
POSTGRES_PASSWORD=misyra-local-only
POSTGRES_PORT=5432
# When changing POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_PORT, update DATABASE_URL to match.
DATABASE_URL=postgresql://misyra:misyra-local-only@127.0.0.1:5432/misyra

AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
# When changing AZURITE_BLOB_PORT/AZURITE_QUEUE_PORT/AZURITE_TABLE_PORT, update AZURE_STORAGE_CONNECTION_STRING to matching explicit emulator endpoints.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
