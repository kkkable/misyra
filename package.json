{
  "name": "misyra",
  "version": "0.0.0",
  "private": true,
  "description": "Misyra mobile application monorepo (toolchain and shared development configuration only).",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:config": "node --test \"tests/config/*.test.mjs\"",
    "audit": "pnpm audit --audit-level=high",
    "infra:validate": "node --test \"tests/toolchain/*.test.mjs\"",
    "dev:up": "node scripts/dev/up.mjs",
    "dev:down": "node scripts/dev/down.mjs",
    "dev:reset": "node scripts/dev/reset.mjs",
    "dev:health": "node scripts/dev/health.mjs",
    "test:services": "node --test \"integration/mts-004/*.test.mjs\"",
    "visual:update-baselines": "node tests/mts-012/update-baselines.mjs",
    "visual:update-image-baselines": "node tests/mts-012/update-image-baselines.mjs",
    "secret:scan": "node scripts/ci/secret-scan.mjs",
    "localization:check": "node scripts/ci/localization-check.mjs",
    "privacy:check": "node scripts/ci/privacy-logging-check.mjs",
    "hardcoded-color:check": "node scripts/ci/hardcoded-color-check.mjs",
    "bicep:validate": "node --test \"tests/mts-006/*.test.mjs\""
  },
  "devDependencies": {
    "@azure/storage-blob": "12.29.1",
    "@eslint/js": "9.39.5",
    "@misyra/eslint-config": "workspace:*",
    "@misyra/prettier-config": "workspace:*",
    "@misyra/test-config": "workspace:*",
    "@misyra/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-native-web": "0.19.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "pg": "8.22.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2",
    "turbo": "2.10.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  }
}
