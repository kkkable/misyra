# Misyra local development environment template (MTS-004).
#
# Copy this file to .env at the repository root to override the deterministic
# defaults that compose.yaml ships. Every value below is a LOCAL-ONLY
# development default: nothing here is a production credential, and nothing
# here ever works against Azure. The .env file itself is gitignored.

# PostgreSQL 18 (service: postgres)
MISYRA_POSTGRES_USER=misyra
MISYRA_POSTGRES_PASSWORD=misyra_local_dev
MISYRA_POSTGRES_DB=misyra
MISYRA_POSTGRES_PORT=5432

# Azurite storage emulator (service: azurite)
MISYRA_AZURITE_BLOB_PORT=10000
MISYRA_AZURITE_QUEUE_PORT=10001
MISYRA_AZURITE_TABLE_PORT=10002

# Azurite always authenticates with the well-known public development
# account documented by Microsoft. These values are fixed by the emulator
# itself; they are recorded here for reference and are not secrets:
#   Account name: devstoreaccount1
#   Account key:  Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
#   Connection:   DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;...
