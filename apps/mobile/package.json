{
  "name": "@misyra/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "build": "tsc --project ./tsconfig.json --noEmit",
    "format": "prettier --write . --config ../../packages/config/prettier.config.mjs && git diff -- src/calendar/calendar-mission-details-route.tsx src/calendar/calendar-mission-details.tsx src/calendar/calendar-mission-duplicate.ts && exit 1",
    "lint": "eslint . --config ../../packages/config/eslint.config.mjs",
    "start": "expo start --dev-client",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "vitest run --config ../../packages/config/vitest.config.mjs --passWithNoTests"
  },
  "dependencies": {
    "@misyra/contracts": "workspace:*",
    "@misyra/design-tokens": "workspace:*",
    "@misyra/domain": "workspace:*",
    "@misyra/localization": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "expo": "57.0.17",
    "expo-haptics": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-router": "57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "3.2.1",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react-test-renderer": "19.2.3"
  }
}
