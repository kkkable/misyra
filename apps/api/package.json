{
  "name": "@misyra/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project ./tsconfig.json --noEmit",
    "format": "prettier --write . --config ../../packages/config/prettier.config.mjs && git diff -- . && exit 1",
    "lint": "eslint . --config ../../packages/config/eslint.config.mjs",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "vitest run --config ../../packages/config/vitest.config.mjs --passWithNoTests"
  },
  "dependencies": {
    "@misyra/contracts": "workspace:*",
    "@misyra/database": "workspace:*",
    "@misyra/domain": "workspace:*",
    "fastify": "5.8.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.20.6"
  }
}
