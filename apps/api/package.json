{
  "name": "@misyra/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify API shell for Misyra. Boots without provider credentials; product endpoints arrive with later tickets.",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --no-emit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@misyra/typescript-config": "workspace:*",
    "fastify": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
