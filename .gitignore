# Dependencies
node_modules/

# Generated build output
dist/
coverage/
.turbo/

# Compiled ARM templates emitted by `az bicep build` (keep Bicep sources only)
infra/azure/**/*.json

# MTS-012 image-harness font rebuild sources (the committed artifact is the
# subset woff2 + glyph inventory; the full Noto Sans SC variable font is large)
scripts/assets/

# Expo generated output
.expo/

# Environment and secrets
.env
.env.*
*.pem
*.p12

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# pnpm's local content-addressable store (pnpm 10 default when no
# store-dir is configured; CI redirects it into the tool cache)
.pnpm-store/

# IDE metadata
.vscode/
.idea/
*.swp

# Operating system junk
.DS_Store
Thumbs.db
desktop.ini

# Expo prebuild output (regenerated deterministically by CI / developers)
apps/mobile/android/
apps/mobile/ios/
